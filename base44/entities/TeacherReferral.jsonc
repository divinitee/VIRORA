{
  "name": "TeacherReferral",
  "properties": {
    "code": {
      "description": "The unique join code. Generated server-side by teacherApi.createGroup (uniqueness-checked); never editable afterwards.",
      "type": "string"
    },
    "color": {
      "description": "Calendar block colour key chosen by the teacher.",
      "enum": [
        "violet",
        "indigo",
        "blue",
        "cyan",
        "emerald",
        "amber",
        "rose",
        "fuchsia"
      ],
      "type": "string"
    },
    "days": {
      "description": "Weekdays this group meets, e.g. [\"Tue\", \"Thu\", \"Sat\"]. Fixed-slot rule (2026-11-12): every day uses the SAME start_time/end_time; per-day times are not supported.",
      "items": {
        "enum": [
          "Mon",
          "Tue",
          "Wed",
          "Thu",
          "Fri",
          "Sat",
          "Sun"
        ],
        "type": "string"
      },
      "type": "array"
    },
    "description": {
      "description": "Optional additional description",
      "maxLength": 1000,
      "type": "string"
    },
    "end_time": {
      "description": "Optional class end time, 24h HH:MM. Must be after start_time.",
      "type": "string"
    },
    "group_status": {
      "default": "running",
      "description": "Whether this group is currently meeting. Ended groups refuse new joins and new homework.",
      "enum": [
        "running",
        "paused",
        "ended"
      ],
      "type": "string"
    },
    "icon": {
      "description": "Optional emoji shown on the calendar block.",
      "maxLength": 16,
      "type": "string"
    },
    "label": {
      "description": "Optional label for this code e.g. 'Group A Morning'",
      "type": "string"
    },
    "level": {
      "description": "CEFR level this group is taught at, e.g. 'B2'.",
      "enum": [
        "Starter",
        "A1",
        "A2",
        "B1",
        "B2",
        "C1"
      ],
      "type": "string"
    },
    "max_capacity": {
      "description": "Maximum seats in the class. Display only (seats left = max_capacity - active roster); joins are not capped by it.",
      "maximum": 200,
      "minimum": 1,
      "type": "number"
    },
    "module": {
      "description": "Free-text module/unit the class is currently on, e.g. 'Module 3'. Display only.",
      "maxLength": 80,
      "type": "string"
    },
    "start_time": {
      "description": "Class start time, 24h HH:MM, e.g. '09:00'. One fixed time for every meeting day.",
      "type": "string"
    },
    "teacher_email": {
      "type": "string"
    },
    "teacher_id": {
      "type": "string"
    },
    "teacher_name": {
      "type": "string"
    },
    "uses": {
      "default": 0,
      "description": "Number of students who joined with this code (incremented by studentApi.joinClass)",
      "type": "number"
    }
  },
  "required": [
    "teacher_id",
    "code"
  ],
  "type": "object",
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.teacher_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}