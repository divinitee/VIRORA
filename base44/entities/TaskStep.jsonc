{
  "name": "TaskStep",
  "properties": {
    "actual_result": {
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "type": "string"
    },
    "completed_by": {
      "type": "string"
    },
    "description": {
      "description": "Instructions: what exactly to do.",
      "type": "string"
    },
    "expected_result": {
      "type": "string"
    },
    "last_actor": {
      "type": "string"
    },
    "order": {
      "default": 0,
      "type": "integer"
    },
    "owner": {
      "description": "Who does this step. Empty = same as the task owner.",
      "enum": [
        "tee",
        "claude",
        "gpt",
        "base44"
      ],
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "type": "string"
    },
    "status": {
      "default": "todo",
      "enum": [
        "todo",
        "in_progress",
        "done",
        "failed",
        "skipped"
      ],
      "type": "string"
    },
    "step_code": {
      "description": "Human-readable step ID: VT-14.2#5.",
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "step_code",
    "task_id",
    "title",
    "status"
  ],
  "type": "object",
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}