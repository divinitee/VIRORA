{
  "description": "VT-40 Coach Engine. Plan SNAPSHOTS for replay and QA: the first plan of each day plus one whenever the plan changes (same plan_hash = no new row). queue holds the explanation objects. Admin-only.",
  "name": "PlanLog",
  "properties": {
    "day": {
      "description": "YYYY-MM-DD, Asia/Tashkent.",
      "type": "string"
    },
    "engine": {
      "description": "Build stamp from the code constants, e.g. coach-plan@1+coach-core@2+coach-graph@1",
      "type": "string"
    },
    "entitlement": {
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "type": "string"
    },
    "goal_id": {
      "type": "string"
    },
    "kind": {
      "description": "today = Today's Practice; continuation = a 'Keep going' session planned fresh from updated learner state.",
      "enum": [
        "today",
        "continuation"
      ],
      "type": "string"
    },
    "learner_level": {
      "description": "VT-40 5b. The learner's CEFR level (A1..C1, or 'unplaced') frozen when the session's FIRST snapshot is written, copied unchanged onto later snapshots of the same session_key. progressApi grades definition_choice against it. Absent on sessions created before 2026-10-26 (legacy): such answers are rejected, never guessed.",
      "type": "string"
    },
    "minutes": {
      "type": "number"
    },
    "plan_hash": {
      "type": "string"
    },
    "policy": {
      "description": "Policy version from coachPolicies, e.g. velvet@2",
      "type": "string"
    },
    "queue": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "session_key": {
      "description": "`<day>:<kind>:<session_no>`. Evidence submitted with this key moves FSRS only for items in this session's snapshots.",
      "type": "string"
    },
    "session_no": {
      "description": "0 for Today's Practice, 1..n for continuation sessions that day.",
      "type": "number"
    },
    "trigger": {
      "enum": [
        "daily_initial",
        "continuation_initial",
        "evidence_changed",
        "goal_changed",
        "time_changed",
        "policy_changed"
      ],
      "type": "string"
    },
    "user_email": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "day",
    "plan_hash",
    "session_key"
  ],
  "type": "object",
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}