{
  "name": "HomeworkSubmission",
  "type": "object",
  "properties": {
    "assignment_id": {
      "type": "string",
      "description": "HomeworkAssignment id"
    },
    "teacher_id": {
      "type": "string"
    },
    "group_id": {
      "type": "string"
    },
    "student_email": {
      "type": "string"
    },
    "student_id": {
      "type": "string"
    },
    "student_name": {
      "type": "string"
    },
    "attempts": {
      "type": "number",
      "default": 0
    },
    "best_score_pct": {
      "type": "number",
      "description": "Best round score 0-100 across attempts"
    },
    "last_score_pct": {
      "type": "number"
    },
    "last_score_verification": {
      "type": "string",
      "enum": [
        "server_graded",
        "server_ai",
        "client_attested",
        "none"
      ],
      "description": "VT-45. How the last score was checked, copied from the RoundReceipt. client_attested = the game reported its own answers (shown to the teacher as 'self-checked'). none = crossword (no scored round)."
    },
    "best_score_verification": {
      "type": "string",
      "enum": [
        "server_graded",
        "server_ai",
        "client_attested",
        "none"
      ],
      "description": "VT-45. Same, for the round that set best_score_pct."
    },
    "first_completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_late": {
      "type": "boolean",
      "default": false,
      "description": "First completion happened after the assignment's due date (Asia/Tashkent calendar day)."
    },
    "last_round_id": {
      "type": "string",
      "description": "RoundReceipt round_id the last score was read from. A round counts once."
    }
  },
  "required": [
    "assignment_id",
    "student_email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.student_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
