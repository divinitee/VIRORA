{
  "name": "LegalDocumentVersion",
  "type": "object",
  "description": "Immutable published legal artifact: exact canonical text of one document type, version and locale, with its SHA-256 (Legal Consent Architecture v1.0 §4). Written only by functions/legalApi (service role, create-only). Never edited: changed text = new version.",
  "properties": {
    "document_id": {
      "type": "string",
      "description": "type:version:locale, e.g. public_offer:1.3:uz"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "public_offer",
        "privacy_notice",
        "data_processing_consent"
      ]
    },
    "version": {
      "type": "string"
    },
    "locale": {
      "type": "string",
      "enum": [
        "uz",
        "ru",
        "en"
      ]
    },
    "content_format": {
      "type": "string",
      "enum": [
        "markdown",
        "text"
      ],
      "default": "markdown"
    },
    "canonical_content": {
      "type": "string",
      "description": "Exact UTF-8 text, line endings normalised to LF."
    },
    "sha256": {
      "type": "string",
      "description": "Lowercase hex SHA-256 of canonical_content."
    },
    "first_release_id": {
      "type": "string",
      "description": "Release draft that first introduced this version."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string",
      "description": "Publisher user id."
    }
  },
  "required": [
    "document_id",
    "document_type",
    "version",
    "locale",
    "canonical_content",
    "sha256"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "never"
      }
    },
    "read": {
      "user_condition": {
        "role": "never"
      }
    },
    "update": {
      "user_condition": {
        "role": "never"
      }
    },
    "delete": {
      "user_condition": {
        "role": "never"
      }
    }
  }
}
