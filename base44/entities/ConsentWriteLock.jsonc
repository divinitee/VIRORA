{
  "name": "ConsentWriteLock",
  "type": "object",
  "description": "Short lease locks that serialise consent writes per user (16 fixed shard rows). Claimed only by functions/legalApi with a conditional updateMany on id + version. Holds a random token, never a user id or other personal data. No client or MCP access.",
  "properties": {
    "shard": {
      "type": "integer",
      "description": "0-15. A user's lock is FNV-1a(user id) mod 16."
    },
    "version": {
      "type": "integer",
      "description": "Incremented on every claim and release; the claim succeeds only if it is unchanged."
    },
    "holder": {
      "type": "string",
      "description": "Random token of the current holder, empty when free."
    },
    "lease_until": {
      "type": "string",
      "format": "date-time",
      "description": "The lock is free after this time even if a holder crashed."
    }
  },
  "required": [
    "shard",
    "version"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "never"
      }
    },
    "read": {
      "user_condition": {
        "role": "never"
      }
    },
    "update": {
      "user_condition": {
        "role": "never"
      }
    },
    "delete": {
      "user_condition": {
        "role": "never"
      }
    }
  }
}
