{
  "description": "One Live Teacher voice lesson. Counters and the teacher's own short summary only: no audio, no transcript. Created and updated only by liveTeacherApi (service role); students read their own rows.",
  "name": "LiveTeacherLesson",
  "properties": {
    "age_group": {
      "enum": [
        "kid",
        "teen",
        "adult"
      ],
      "type": "string"
    },
    "duration_s": {
      "type": "number"
    },
    "ended_at": {
      "type": "string"
    },
    "focus_next": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "level_at_end": {
      "type": "string"
    },
    "mastered_now": {
      "type": "number"
    },
    "max_minutes": {
      "description": "Hard length of this lesson (core MAX_MINUTES). Tools are refused 5 minutes past it.",
      "type": "number"
    },
    "mistakes": {
      "description": "This lesson's mistakes, one per key, newest last (max 30): { key, rule, variant, wrong, correct, explanation_uz, status, count }. Shown in the recap.",
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "mistakes_logged": {
      "type": "number"
    },
    "mode": {
      "enum": [
        "normal",
        "strict",
        "exam"
      ],
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "new_mistakes": {
      "type": "number"
    },
    "repeated_mistakes": {
      "type": "number"
    },
    "scores": {
      "description": "Exam mode only.",
      "type": "object"
    },
    "started_at": {
      "type": "string"
    },
    "status": {
      "enum": [
        "started",
        "ended"
      ],
      "type": "string"
    },
    "strengths": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "summary": {
      "type": "string"
    },
    "tool_calls": {
      "type": "number"
    },
    "user_email": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "mode",
    "status"
  ],
  "type": "object",
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}