{
  "name": "Task",
  "properties": {
    "ai_minutes": {
      "default": 0,
      "description": "Estimated unattended AI execution minutes. Usually non-zero for Claude tasks.",
      "type": "integer"
    },
    "archived": {
      "default": false,
      "type": "boolean"
    },
    "archived_at": {
      "format": "date-time",
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "type": "string"
    },
    "department": {
      "default": "tech",
      "description": "Company section: Tech (product/dev), Marketing (content, ads, outreach), Finance (money, pricing, payments decisions), Ops (accounts, admin, operations).",
      "enum": [
        "tech",
        "marketing",
        "finance",
        "ops"
      ],
      "type": "string"
    },
    "depends_on": {
      "description": "Task codes this task depends on. A task is execution-blocked until all dependencies are complete.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "description": {
      "type": "string"
    },
    "due_date": {
      "description": "YYYY-MM-DD",
      "type": "string"
    },
    "energy": {
      "default": "med",
      "description": "Minimum human energy required for the hands-on portion.",
      "enum": [
        "low",
        "med",
        "high"
      ],
      "type": "string"
    },
    "estimate_minutes": {
      "default": 15,
      "description": "Estimated total human hands-on minutes. For Claude work this means kickoff + review, not unattended runtime.",
      "type": "integer"
    },
    "focus_rank": {
      "default": 0,
      "description": "Position on the Focus roadmap: 1 = now, 2+ = up next, 0 = backlog.",
      "type": "integer"
    },
    "last_actor": {
      "type": "string"
    },
    "launch_blocker": {
      "default": false,
      "type": "boolean"
    },
    "order": {
      "default": 0,
      "type": "integer"
    },
    "owner": {
      "default": "tee",
      "description": "Who is responsible for doing this task.",
      "enum": [
        "tee",
        "claude",
        "gpt",
        "base44"
      ],
      "type": "string"
    },
    "parent_id": {
      "description": "Parent Task.id. Empty for root.",
      "type": "string"
    },
    "place": {
      "default": "anywhere",
      "description": "Execution context required for the hands-on portion.",
      "enum": [
        "laptop",
        "home",
        "phone",
        "anywhere",
        "out"
      ],
      "type": "string"
    },
    "priority": {
      "default": "medium",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "type": "string"
    },
    "project": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "type": "string"
    },
    "status": {
      "default": "raw_idea",
      "enum": [
        "raw_idea",
        "planned",
        "in_progress",
        "complete"
      ],
      "type": "string"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "task_code": {
      "description": "Human-readable hierarchical ID.",
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "verified_at": {
      "format": "date-time",
      "type": "string"
    },
    "verified_by": {
      "type": "string"
    },
    "work_mode": {
      "default": "hands_on",
      "description": "Who does the substantive work: Tee, Claude, or both.",
      "enum": [
        "hands_on",
        "claude",
        "hybrid"
      ],
      "type": "string"
    }
  },
  "required": [
    "task_code",
    "title",
    "status",
    "priority"
  ],
  "type": "object",
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}