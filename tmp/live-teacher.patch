+    const l1 = new Lesson({ id: 'L1' });
+    await l1.say('I goes to school.');
+    l1.profile = finishLesson(applyLevelEstimate(l1.profile, { cefr: 'A2' }).profile, { mode: 'strict', summary: 'Present Simple basics.', focusNext: ['he/she + s'] });
