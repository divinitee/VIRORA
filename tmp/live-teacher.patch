+const checks = [];
+const check = (label, ok) => { checks.push({ label, ok }); console.log(`  ${ok ? 'PASS' : 'CHECK BY HAND'}: ${label}`); };
+const hasUzbek = (t) => /\b(ishlatiladi|emas|xato|tushun|ayting|takrorlang|bilan|uchun|qani|diqqat)\b/i.test(t);
